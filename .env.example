# Preenchido por `neon deploy` / `neon env pull` (nunca edite à mão)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
NEON_BRANCH_ID=
NEON_FUNCTION_HOST_SUFFIX=

# Conexões por instância. 1 em serverless (Vercel).
DATABASE_POOL_MAX=1

# Better Auth. O segredo precisa de 32 caracteres ou mais (ex.: openssl rand -hex 32)
BETTER_AUTH_URL=http://localhost:3100
BETTER_AUTH_SECRET=

# Os 2 usuários criados por `pnpm db:seed`
SEED_USER_ONE_EMAIL=
SEED_USER_ONE_PASSWORD=
SEED_USER_TWO_EMAIL=
SEED_USER_TWO_PASSWORD=
