{
  "extends": "./config/tsconfig/next.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@vibru/shared": ["./legacy/shared/src/index.ts"],
      "@vibru/shared/*": ["./legacy/shared/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "next.config.ts",
    "neon.ts",
    "drizzle.config.ts"
  ],
  "exclude": ["node_modules", "legacy"]
}
